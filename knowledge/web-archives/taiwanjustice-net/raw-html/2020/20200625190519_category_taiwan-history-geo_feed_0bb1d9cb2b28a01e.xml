	<item>
		<title>警總機密文件曝光！ 揭露國民黨黨國、竹聯幫掛勾內幕</title>
		<link>https://www.taiwanjustice.net/2020/06/23/%e8%ad%a6%e7%b8%bd%e6%a9%9f%e5%af%86%e6%96%87%e4%bb%b6%e6%9b%9d%e5%85%89%ef%bc%81-%e6%8f%ad%e9%9c%b2%e5%9c%8b%e6%b0%91%e9%bb%a8%e9%bb%a8%e5%9c%8b%e3%80%81%e7%ab%b9%e8%81%af%e5%b9%ab%e6%8e%9b%e5%8b%be/</link>
