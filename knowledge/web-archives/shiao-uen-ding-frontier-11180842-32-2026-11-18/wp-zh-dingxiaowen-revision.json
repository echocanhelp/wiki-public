{"continue":{"rvcontinue":"20260813215211|93882466","continue":"||"},"query":{"pages":{"7879020":{"pageid":7879020,"ns":0,"title":"\u4e01\u66c9\u96ef","revisions":[{"timestamp":"2026-09-13T10:40:47Z","slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","*":"{{\u85dd\u4eba\n| \u59d3\u540d = \u4e01\u66c9\u96ef\n| \u985e\u578b = \u5973\u6b4c\u624b\n| \u5716\u7247 = \n| \u5716\u7247\u5c3a\u5bf8 = \n| \u5716\u7247\u7c21\u4ecb = \n| \u82f1\u6587\u540d = Rachel Ting\n| \u51fa\u751f\u65e5\u671f = {{birth date and age|1963|10|2}}\n| \u51fa\u751f\u5730\u9ede = [[\u4e2d\u83ef\u6c11\u570b]]\n| \u8077\u696d = \u97f3\u6a02\u88fd\u4f5c\u4eba\u3001\u8a5e\u66f2\u4f5c\u5bb6\u3001\u6b4c\u624b\n| \u8a9e\u8a00 = [[\u4e2d\u83ef\u6c11\u570b\u570b\u8a9e|\u570b\u8a9e]]\n| \u6559\u80b2\u7a0b\u5ea6 = [[\u5317\u4e00\u5973\u4e2d]]<br>[[\u8f14\u4ec1\u5927\u5b78]]\u5927\u773e\u50b3\u64ad\u5b78\u7cfb\u5b78\u58eb\n| \u914d\u5076 = \n| \u97f3\u6a02\u985e\u578b = \n| \u6f14\u594f\u6a02\u5668 = \n| \u51fa\u9053\u65e5\u671f = \n| \u51fa\u9053\u4f5c = \n| \u6d3b\u8e8d\u5e74\u4ee3 = 1985\u5e74\u81f3\u4eca\n| \u5531\u7247\u516c\u53f8 = [[\u98db\u789f\u5531\u7247]]<br>[[\u6efe\u77f3\u5531\u7247]]<br>[[\u83ef\u7d0d\u97f3\u6a02 (\u53f0\u7063)|\u83ef\u7d0d\u5531\u7247]]\n| \u7d93\u7d00\u516c\u53f8 = \u83ef\u7d0d\u97f3\u6a02\u51fa\u7248\u516c\u53f8<br>\u5f8b\u91ce\u50b3\u64ad\u6709\u9650\u516c\u53f8<br>\u91d1\u5f8b\u97f3\u6a02\u88fd\u4f5c\u6709\u9650\u516c\u53f8<br>\u4e2d\u5531\u6578\u4f4d\u5a1b\u6a02\u80a1\u4efd\u6709\u9650\u516c\u53f8\n| \u7db2\u7ad9 = \n| \u76f8\u95dc\u5718\u9ad4 = \n| \u734e\u9805 = \n}}\n'''\u4e01\u66c9\u96ef'''{{BD|1963\u5e74|10\u67082\u65e5}}\uff0c[[\u53f0\u7063]]\u97f3\u6a02\u88fd\u4f5c\u4eba\u3001\u8a5e\u66f2\u4f5c\u5bb6\u53ca\u5973\u6b4c\u624b\u3002\n\n== \u65e9\u5e74 ==\n\u4e01\u66c9\u96ef\u5c0d\u97f3\u6a02\u7684\u559c\u611b\u81ea\u5c0f\u6642\u5019\u958b\u59cb\uff0c\u5e74\u5e7c\u6642\u5979\u7d93\u5e38\u548c\u5bb6\u4eba\u4e00\u8d77\u770b\u300a[[\u7fa4\u661f\u6703]]\u300b\uff0c\u548c\u54e5\u54e5\u4e00\u8d77\u807d\u9ed1\u81a0\u5531\u7247\u300c\u5b78\u751f\u4e4b\u97f3\u300d\uff0c\u4e5f\u5e38\u5e38\u8ddf\u8457\u97f3\u6a02\u6a21\u4eff\u6b4c\u661f\u5531\u6b4c\u3002\u4e01\u66c9\u96ef\u5728\u5b78\u751f\u6642\u671f\uff0c\u4f5c\u6587\u8ab2\u5beb\u7684\u65b0\u8a69\u5e38\u7372\u5f97\u8001\u5e2b\u6b63\u9762\u7684\u8a55\u8a9e\uff0c\u800c\u5979\u4e5f\u8a8d\u70ba\u5f8c\u4f86\u6703\u5f9e\u4e8b\u6b4c\u8a5e\u5275\u4f5c\u4e5f\u6709\u4e00\u90e8\u5206\u662f\u56e0\u70ba\u7576\u6642\u570b\u4e2d\u7684\u5beb\u4f5c\u57f9\u990a\u4ee5\u53ca\u5f8c\u4f86\u6c11\u6b4c\u904b\u52d5\u7684\u555f\u8499\u3002<ref name=2u>{{cite book |author1=\u4e01\u66c9\u96ef |title=\u6bcf\u500b\u4eba\u5fc3\u4e2d\u90fd\u6709\u4e00\u9996\u6b4c |date=2014 |publisher=\u53f0\u5546\u8cc7\u6e90\u570b\u969b\u6709\u9650\u516c\u53f8 |isbn=978-986-903221-6}}</ref>\n\n80\u5e74\u4ee3\uff0c\u4e01\u66c9\u96ef\u5c31\u8b80\u8f14\u4ec1\u5927\u5b78\u7684\u5927\u773e\u50b3\u64ad\u5b78\u7cfb\uff0c\u4e3b\u4fee\u5ee3\u544a\u3001\u96fb\u5f71\u3001\u96fb\u8996\u3001\u651d\u5f71\u3002\u7576\u6642\uff0c\u5979\u548c\u597d\u53cb\u4e00\u8d77\u53c3\u52a0[[\u8f14\u4ec1\u5927\u5b78]]\u9752\u97fb\u734e\uff0c\u7372\u5f97\u7b2c\u4e00\u5c46\u5275\u4f5c\u7d44\u51a0\u8ecd\u3002\u9694\u5e74\uff0c\u5979\u53c3\u52a0[[\u5927\u5b78\u57ce\u5168\u570b\u5927\u5c08\u5275\u4f5c\u6b4c\u8b20\u5927\u8cfd]]\uff0c\u7372\u5f97\u5275\u4f5c\u7d44\u7b2c\u4e8c\u540d\u53ca\u6700\u4f73\u6f14\u5531\u734e\uff08\u5275\u4f5c\u66f2\u70ba\u300a\u795e\u8a71\u300b\uff0c\u6f14\u5531\u66f2\u70ba[[\u9673\u6587\u73b2]]\u5beb\u7684\u300a\u544a\u767d\u300b\uff09\u3002\u7b2c\u4e09\u5c46\u518d\u6b21\u53c3\u8cfd\uff0c\u4ee5\u300a\u5982\u679c\u80fd\u5920\u300b\u7372\u5f97\u5275\u4f5c\u7d44\u7b2c\u4e8c\u540d\uff0c\u9019\u4e9b\u734e\u9805\u4e5f\u6210\u70ba\u5f8c\u4f86\u51fa\u5927\u5b78\u57ce\u5408\u8f2f\u300a\u98db\u63da\u7684\u9752\u6625\u300b\u4e26\u6210\u70ba\u6b4c\u624b\u7684\u5951\u6a5f\u3002<ref name=2p>{{cite book |author1=\u9673\u6a02\u878d |title=\u6211\uff0c\u4f5c\u8a5e\u5bb6 |date=2010 |publisher=[[\u5929\u4e0b\u96dc\u8a8c]] |isbn=978-986-241090-5}}</ref>\n\n== \u4e8b\u696d ==\n\u5927\u5b78\u57ce\u5408\u8f2f\u300c\u98db\u63da\u7684\u9752\u6625\u300d\u767c\u884c\u4e4b\u5f8c\uff0c\u4e01\u66c9\u96ef\u88ab[[\u98db\u789f\u5531\u7247]]\u8001\u95c6[[\u5433\u695a\u695a]]\u7c3d\u4e0b\uff0c\u548c[[\u6797\u9686\u7487]]\u5408\u767c\u4e86\u300c\u8d70\u51fa\u6821\u5712\u4ee5\u5f8c\u300d\u5c08\u8f2f\u3002\u9304\u88fd\u5531\u7247\u7684\u904e\u7a0b\u4e2d\uff0c\u4e01\u66c9\u96ef\u63a5\u89f8\u5230\u88fd\u4f5c\u5531\u7247\u7684\u5404\u500b\u9762\u5411\uff0c\u89ba\u5f97\u5341\u5206\u611f\u8208\u8da3\uff0c\u56e0\u6b64\u5f8c\u4f86\u8f49\u505a\u5e55\u5f8c\u5de5\u4f5c\uff0c\u96e2\u958b\u4e86\u98db\u789f\u5531\u7247\u3001\u52a0\u5165[[\u6efe\u77f3\u5531\u7247]]\uff0c\u8ddf\u8457[[\u674e\u5b97\u76db]]\u4e00\u8d77\u88fd\u4f5c\u5531\u7247\u3002<ref name=2y>{{cite web|url=https://www.chinatimes.com/realtimenews/20151009003960-260405?chdtv|title=\u6c11\u6b4c\u50b3\u5947\u5728\u53f0\u4e2d\u300b\u6c92\u5531\u5230\u9019\u9996\u6b4c \u4e01\u66c9\u96ef\u591a\u5fd930\u5e74|access-date=2022-02-22|archive-date=2022-03-07|archive-url=https://web.archive.org/web/20220307141006/https://www.chinatimes.com/realtimenews/20151009003960-260405?chdtv}}</ref>\n\n\u7576\u6642\u5f9e\u88fd\u4f5c\u52a9\u7406\u958b\u59cb\u7684\u4e01\u66c9\u96ef\uff0c\u7d2f\u7a4d\u4e86\u548c\u8a31\u591a\u5927\u5e2b\u7d1a\u88fd\u4f5c\u4eba\u5408\u4f5c\u7684\u7d93\u9a57\uff0c\u5305\u62ec\u8ddf[[\u6c88\u5149\u9060]]\u88fd\u4f5c[[\u6f58\u8d8a\u96f2]]\u300c\u7d17\u7684\u543b\u300d\u3001\u8ddf\u674e\u5b97\u76db\u88fd\u4f5c[[\u9673\u6dd1\u6a3a]]\u300c\u5973\u4eba\u5fc3\u300d\u4ee5\u53ca\u8ddf[[\u674e\u6cf0\u7965]]\u88fd\u4f5c[[\u5510\u66c9\u8a69]]\u300c\u4e0a\u4e86\u4f60\u766e\u300d\u7b49\u3002\u4e01\u66c9\u96ef\u9996\u5ea6\u81ea\u5df1\u64d4\u7db1\u88fd\u4f5c\u4eba\u7684\u7b2c\u4e00\u5f35\u5c08\u8f2f\u70ba[[\u6885\u8c54\u82b3]]\u300c\u70c8\u7130\u7d05\u5507\u300d\u3002<ref name=2u/><ref>{{cite web |url=https://www.chinatimes.com/cn/realtimenews/20180820004004-260404?chdtv |title=\u4e01\u6653\u96ef\u5f53\u5e74\u6bd4\u8d5b\u6253\u8d25\u6797\u5fd7\u70ab \u4f18\u5ba2\u674e\u6797\u5e55\u540e\u63a8\u624b\u662f\u5979 |access-date=2022-02-22 |archive-date=2022-03-04 |archive-url=https://web.archive.org/web/20220304091113/https://www.chinatimes.com/cn/realtimenews/20180820004004-260404?chdtv }}</ref>\n\n\u5728\u53f0\u7063\u97f3\u6a02\u7522\u696d\u84ec\u52c3\u767c\u5c55\u76841990\u5e74\u4ee3\uff0c\u4e01\u66c9\u96ef\u70ba\u738b\u5091\u300c\u4f60\u662f\u6211\u80f8\u53e3\u6c38\u9060\u7684\u75db\u300d\u4e00\u66f2\u586b\u8a5e\uff0c\u9019\u9996\u6b4c\u642d\u914d\u7576\u5e74[[\u738b\u5bb6\u885b]]\u7684\u96fb\u5f71\u300c[[\u65fa\u89d2\u5361\u9580]]\u300d\uff08\u53f0\u7063\u7247\u540d:\u71b1\u8840\u7537\u5152\uff09\uff0c\u662f\u7576\u6642\u7372\u5f97\u5e02\u5834\u6210\u529f\u7684\u71b1\u9580\u6b4c\u66f2\uff0c\u4e5f\u6210\u70ba\u4e86\u4e01\u66c9\u96ef\u7684\u6b4c\u8a5e\u6210\u540d\u4f5c\u3002\u5f8c\u4f86\uff0c\u4e01\u66c9\u96ef\u9678\u9678\u7e8c\u7e8c\u767c\u8868\u6b4c\u8a5e\u4f5c\u54c1\uff0c\u5982[[\u5c0f\u864e\u968a]]\u7684\u300c\u9752\u860b\u679c\u6a02\u5712\u300d\u3001[[\u6797\u61b6\u84ee]]\u300c\u611b\u4e0a\u4e00\u500b\u4e0d\u56de\u5bb6\u7684\u4eba\u300d\u3001[[\u5f35\u5b78\u53cb]]\u300c\u795d\u798f\u300d\u3001\u9673\u6dd1\u6a3a\u300c\u611b\u5f97\u6bd4\u8f03\u6df1\u300d\u3001[[\u8b5a\u8a60\u9e9f]]\u300c\u9752\u6625\u5922\u300d\u3001[[\u9cf3\u98db\u98db]]\u300c\u6211\u7684\u611b\u3001\u6211\u7684\u5922\u3001\u6211\u7684\u5bb6\u300d\u7b49\u3002<ref name=2u/>\n\n\u7531\u65bc\u8d77\u521d\u4ee5\u6b4c\u624b\u7684\u8eab\u4efd\u9032\u5165\u97f3\u6a02\u7522\u696d\uff0c\u4e01\u66c9\u96ef\u767c\u904e\u591a\u6b21\u5927\u5b78\u57ce\u5408\u8f2f\uff0c\u4e26\u8207\u6797\u9686\u7487\u4e00\u540c\u5408\u767c\u300c\u8d70\u51fa\u6821\u5712\u4ee5\u5f8c\u300d\u5c08\u8f2f\u30022014\u5e74\uff0c\u4e01\u66c9\u96ef\u8209\u8fa6\u4e86\u51fa\u905330\u5e74\u4f86\u7b2c\u4e00\u5834\u500b\u4eba\u6f14\u5531\u6703\u53ca\u51fa\u7248\u500b\u4eba\u97f3\u6a02\u5c0f\u50b3\u300c\u6bcf\u500b\u4eba\u5fc3\u4e2d\u90fd\u6709\u4e00\u9996\u6b4c\u300d\u3002\u4e01\u66c9\u96ef\u4ea6\u64d4\u4efb\u904e\u8a31\u591a\u97f3\u6a02\u76f8\u95dc\u6bd4\u8cfd\u7684\u8a55\u5be9\u5de5\u4f5c\uff0c\u64d4\u4efb\u8a55\u5be9\u7684\u5834\u5408\u5305\u62ec[[\u91d1\u9418\u734e]]\u3001[[\u91d1\u66f2\u734e]]\u3001[[\u6e56\u5357\u885b\u8996]]\u300c[[\u6211\u662f\u6b4c\u624b]]\u300d\u3001[[\u6c11\u8996]]\u300c\u660e\u65e5\u4e4b\u661fSuper Star\u300d\u3001[[\u6296\u97f3]]\u300c\u770b\u898b\u97f3\u6a02\u8a08\u756b\u300d\u7b49\u3002\u73fe\u5728\u4e01\u66c9\u96ef\u4ecd\u70ba\u96fb\u8996\u7d9c\u85dd\u7bc0\u76ee\u97f3\u6a02\u55ae\u5143\u4e4b\u5e38\u614b\u6027\u8a55\u5be9\u3002\u9664\u4e86\u64d4\u4efb\u8a55\u5be9\uff0c\u4e01\u66c9\u96ef\u4e5f\u6642\u5e38\u53d7\u9080\u64d4\u4efb\u6d3b\u52d5\u548c\u5ee3\u64ad\u7bc0\u76ee\u7684\u4e3b\u6301\uff0c\u5305\u62ec\u6f14\u5531\u6703\u985e\u578b\u6d3b\u52d5\uff0c\u5982\u300c[[\u81fa\u5317\u5ee3\u64ad\u96fb\u81fa]]\u5e74\u5ea6\u6d3b\u52d5\u300e\u9081\u5411107\u2014\u5e78\u798f\u6eff\u6eff\u6d3e\u5c0d\u300f\u6f14\u5531\u6703\u300d\u3001\u300c[[\u81fa\u5317\u5e02\u7acb\u4ea4\u97ff\u6a02\u5718]]\u300e\u4f60\u662f\u6211\u6240\u6709\u7684\u56de\u61b6 \u2013 \u7121\u75d5\u97f3\u6a02\u6703\u300f\u300d\u3001\u300c[[\u8f14\u4ec1\u5927\u5b78]]\u300e\u90a3\u4e00\u6bb5\u8f14\u4ec1's\u5e78\u798f\u6642\u5149 \u2013 520\u6c11\u6b4c\u6f14\u5531\u6703\u300f\u300d\u7b49\uff0c\u4e5f\u6709\u8b1b\u5ea7\u985e\u578b\u6d3b\u52d5\uff0c\u5982\u300c\u7f85\u5927\u4f51\u8b1b\u5ea7\u300e\u97f3\u6a02\u8207\u96fb\u5f71\u7684\u6545\u4e8b\u300f\u300d\u548c\u300c\u7fc1\u5029\u7389\u7248\u756b\u4f5c\u54c1\u5c55\u5ea7\u8ac7\u6703\u300d\u7b49\uff0c\u53e6\u5916\u4e5f\u6709\u5176\u4ed6\u97f3\u6a02\u985e\u6d3b\u52d5\u5982\u300c\u5f35\u5fc3\u5091\u5c08\u8f2f\u767c\u4f48\u8a18\u8005\u6703\u300d\u548c\u300c\u5927\u5b78\u57ce\u5275\u4f5c\u6b4c\u8b20\u6bd4\u8cfd\u300d\u7b49\uff0c\u4ee5\u53ca\u81fa\u5317\u5ee3\u64ad\u96fb\u81fa\u7bc0\u76ee\u300c\u66c9\u96ef\u8001\u5e2b\u4e0d\u5531\u6b4c\u300d\u7b49\u3002<ref name=2u/><ref name=2y/>\n\n== \u4ee3\u8868\u4f5c ==\n\u4e01\u66c9\u96ef\u81f3\u4eca\u5df2\u767c\u8868\u903e400\u591a\u9996\u4f5c\u54c1\uff0c\u6b77\u5e74\u4ee3\u8868\u4f5c\u6709<ref name=2u/><ref name=2p/><ref>{{Cite web|title=\u6700\u6709\u624d\u83ef\u7684\u674e\u5b97\u76db\u52a9\u7406\uff0c\u7de0\u9020\u4e00\u4ee3\u6b4c\u58c7\uff0c\u524d\u5875\u4e8b\u96e3\u4ee5\u7d30\u6578|url=http://pttnews.cc/7efb85d0e4|access-date=2022-05-18|work=PTT\u65b0\u805e|archive-date=2024-12-27|archive-url=https://web.archive.org/web/20241227110822/http://pttnews.cc/7efb85d0e4|url-status=live}}</ref>\uff1a\n{| class=\"wikitable\"\n|'''\u6b4c\u540d'''\n|'''\u6b4c\u624b'''\n|-\n|[[\u5fd8\u4e86\u4f60\u5fd8\u4e86\u6211|\u4f60\u662f\u6211\u80f8\u53e3\u6c38\u9060\u7684\u75db]]\n|[[\u738b\u5091 (\u6b4c\u624b)|\u738b\u5091]]\u3001\u8449\u6b61\n|-\n|[[\u65b0\u5e74\u5feb\u6a02 (1989\u5e74\u5c08\u8f2f)|\u9752\u860b\u679c\u6a02\u5712]]\u3001[[\u7d05\u873b\u8713|\u9031\u672b\u5609\u5e74\u83ef]]\u3001[[\u900d\u9059\u904a (\u5c0f\u864e\u968a\u5c08\u8f2f)|\u611b\u60c5\u8b8a\u5316\u7403]]\n|[[\u5c0f\u864e\u968a]]\n|-\n|[[\u611b\u4e0a\u4e00\u500b\u4e0d\u56de\u5bb6\u7684\u4eba]]\u3001[[\u611b\u4e0a\u4e00\u500b\u4e0d\u56de\u5bb6\u7684\u4eba|\u4f60\u7d66\u6211\u7684\u611b\u4e0d\u662f\u611b]]\u3001[[\u611b\u4e0a\u4e00\u500b\u4e0d\u56de\u5bb6\u7684\u4eba|\u54c8\u56c9\u5bc2\u5bde]]\n|[[\u6797\u61b6\u84ee]]\n|-\n|\u6709\u60c5\u4eba\u7e3d\u88ab\u7121\u60c5\u50b7\n|[[\u6b50\u967d\u83f2\u83f2]]\n|-\n|[[\u795d\u798f (\u5f35\u5b78\u53cb\u5c08\u8f2f)|\u795d\u798f]]\u3001[[\u5077\u5fc3]]\u3001[[\u4e0d\u5f8c\u6094|\u7d05\u8272]]\u3001[[\u795d\u798f (\u5f35\u5b78\u53cb\u5c08\u8f2f)|\u6700\u5f8c\u4e00\u5c01\u4fe1]]\u3001[[\u64c1\u53cb|\u5982\u679c\u4f60\u61c2]]\n|[[\u5f20\u5b66\u53cb|\u5f35\u5b78\u53cb]]\n|-\n|\u6b98\u7f3a\u7684\u6eab\u67d4\n|[[\u8449\u74a6\u83f1|\u8449\u7477\u83f1]]\n|-\n|[[\u6dd1\u6a3a\u76db\u958b|\u611b\u5f