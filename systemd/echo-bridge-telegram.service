[Unit]
Description=Echo Telegram bridge (long polling)
After=network-online.target
Wants=network-online.target
PartOf=echo-bridges.target

[Service]
Type=simple
WorkingDirectory=/home/leedt/echo-system/bridges
EnvironmentFile=-/home/leedt/echo-system/bridges/.env
ExecStart=/home/leedt/echo-system/bridges/.venv/bin/python3 /home/leedt/echo-system/bridges/telegram/bridge.py
Restart=always
RestartSec=5
StandardOutput=append:/home/leedt/echo-system/bridges/logs/telegram.log
StandardError=append:/home/leedt/echo-system/bridges/logs/telegram.log

[Install]
WantedBy=echo-bridges.target default.target