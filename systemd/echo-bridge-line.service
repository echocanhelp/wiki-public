[Unit]
Description=Echo LINE webhook bridge
After=network-online.target
Wants=network-online.target
PartOf=echo-bridges.target

[Service]
Type=simple
WorkingDirectory=/home/leedt/echo-system/bridges
EnvironmentFile=-/home/leedt/echo-system/bridges/.env
ExecStart=/home/leedt/echo-system/bridges/.venv/bin/python3 /home/leedt/echo-system/bridges/line/bridge.py
Restart=always
RestartSec=5
StandardOutput=append:/home/leedt/echo-system/bridges/logs/line.log
StandardError=append:/home/leedt/echo-system/bridges/logs/line.log

[Install]
WantedBy=echo-bridges.target default.target