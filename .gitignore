# Echo vault (local)

# Staging / logs (legacy paths)
echopedia/staging/
echopedia/logs/

# Runtime / private Tier 2 captures (not for Pages)
knowledge/interactions/
knowledge/oral-stories/
knowledge/web-archives/
knowledge/research/*/units.jsonl
knowledge/research/*/posts-index.json
cache/
**/__pycache__/
*.pyc

# Auto-generated ops artifacts (ci-heal output)
echopedia/ci-heal-brief.md
echopedia/last-good-deploy.json

# Audiobook production masters (still in vault for Obsidian; not for public git)
audiobook-albert-lai/

# Large media files (>20MB Obsidian limit)
albert-ch01-en-christopher-v1-scratch.mp3

# OS / editor
.DS_Store
.obsidian/workspace*
.obsidian/workspace.json
.obsidian/cache

# Private LINE identity (never public)
echopedia/identity/

# Private legal docs (IRS letters, etc.)
knowledge/operational/tahs-legal/

# Large auto-generated search index (regenerated by Quartz build)
public/static/contentIndex.json
cache/

# Private creds
secrets/

# Hermes / agent worktrees — gitlinks without .gitmodules break
# GitHub Pages checkout (`submodules: recursive` → exit 128)
.worktrees/


# Worker scratch: per-slice work files, regenerated every pass. These MUST stay
# untracked. Two lessons, both learned the hard way:
#   2026-10-08  git add -A swept ~32k of them into one commit and the Pages deployer
#             timed out polling updating_pages.
#   2026-10-09  a gitignore rule added AFTER files are committed does nothing —
#             ignore only applies to untracked paths. 34,722 slice files stayed
#             tracked and churned on every commit until `update-index --force-remove`.
# Covers every builder: tjj-a / deepen-x / deepen-r / deepen-wave / tah-a.
knowledge/operational/deepen-x-slice-*.txt
knowledge/operational/tjj-a-slice-*.txt
knowledge/operational/deepen-r-slice-*.txt
knowledge/operational/deepen-wave-slice-*.txt
knowledge/operational/tah-a-slice-*.txt
