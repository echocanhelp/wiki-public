# Credentials and secrets — never commit live tokens
.env
**/.env
**/.env.*
!**/.env.example
*.key
*.pem
**/*.secret
**/runtime/backups/**/*.env
echopedia/ingest/**/.env.bak*
echopedia/ingest/**/profiles/**/auth.json
echopedia/ingest/**/profiles/**/sessions/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Logs
logs/
logs.*
*.log

# PID files
*.pid

# IDE
.idea/
.vscode/
*.swp
*.swo

# Media (large files)
media/
**/*.mp4
**/*.mov
**/*.avi

# Hermes scratch
.scratch/
.herme/

# OS
.DS_Store
Thumbs.db

# Quartz / site build (wiki-public layout)
node_modules
quartz-engine/public
quartz-engine/quartz/.quartz-cache
public/
quartz
!quartz-engine/quartz/
moderation-webhook/
/root/package.json
/root/package-lock.json

# Local DB snapshots (not for public git)
**/*.db
state-snapshots/
# Private LINE identity registry (never publish)
echopedia/identity/

# Generated Quartz emit at repo root (publish copies; public/ already ignored)
/index.html
/people/
/organizations/
/tags/
/events/
/sources/
/articles/

# Tier2 archive markdown (too large for normal git status noise; live under content/articles)
/content/articles/

# Local ops briefs regenerated by cron (status is machine-generated)
/echopedia/SYSTEM_STATUS.md
/echopedia/ci-heal-brief.md
/echopedia/janitor-brief.md
/echopedia/pages-deploy-brief.md
/echopedia/logs/
/echopedia/audit-state.json

# Local knowledge ops outputs
/knowledge/operational/
/knowledge/interactions/

# Large local-only corpora
/audiobook-albert-lai/

# Local vault search cache
/cache/
