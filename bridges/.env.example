# Echo System 3.0 messaging bridges — copy to .env and fill values.
# Import from legacy: scripts/import-bridge-env.sh

# --- Shared ---
ECHO_ROOT=/home/leedt/echo-system
BRIDGE_ADMIN_KEY=change-me-admin-key
BRIDGE_RATE_LIMIT_PER_MINUTE=6
BRIDGE_RATE_LIMIT_PER_HOUR=30
BRIDGE_GLOBAL_RATE_PER_MINUTE=60
BRIDGE_TAU_TIMEOUT=600
BRIDGE_MAX_MESSAGE_CHARS=4000
BRIDGE_SESSION_CONTINUITY=true
ECHO_WHISPER_URL=http://localhost:8002/v1
BRIDGE_LOG_LEVEL=INFO

# --- Telegram (long polling) ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_TYPING_INTERVAL=3
TELEGRAM_PROGRESS_AFTER=15
TELEGRAM_CHUNK_CHARS=4096
TELEGRAM_STATUS_INTERVAL=12

# --- LINE (webhook) ---
LINE_ENABLED=true
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_ID=
LINE_ALLOWED_GROUPS=
LINE_ALLOW_ALL_USERS=false
LINE_ALLOWED_USERS=
LINE_WEBHOOK_PORT=8787
LINE_WEBHOOK_PATH=/line/webhook
# Public HTTPS base (set automatically by start-ngrok.sh), no trailing slash
LINE_PUBLIC_URL=
LINE_MEDIA_PATH=/line/media
LINE_PROGRESS_AFTER=30
LINE_LOADING_SECONDS=60

# --- ngrok (LINE public webhook) ---
NGROK_AUTHTOKEN=
# Optional reserved domain (same ngrok account as legacy Echo)
NGROK_DOMAIN=bucked-diabetes-shucking.ngrok-free.dev
# Optional: require X-Bridge-Key header on webhook (in addition to LINE signature)
LINE_WEBHOOK_BRIDGE_KEY=