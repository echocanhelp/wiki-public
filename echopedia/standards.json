{
  "version": 8,
  "updated": "2026-07-28",
  "description": "Bump version when echopedia-ops / linking / ingestion standards change so the janitor re-prioritizes the corpus. Added content analysis integration (v8).",
  "rules": [
    "identity_snapshot",
    "related_pages",
    "last_reviewed",
    "no_broken_wikilinks",
    "first_mention_body_links",
    "sources_work_page_for_major_works",
    "sources_github_callout_for_work_hosts",
    "no_knowledge_wikilinks",
    "publish_via_echopedia_publish_sh",
    "ops_check_before_trusting_map",
    "deploy_drift_check",
    "fact_sheet_freshness",
    "entity_hints_sync",
    "l2_auto_heal",
    "l3_auto_push_on_green",
    "l2_auto_featured_on_publish",
    "l2_auto_site_design",
    "content_analysis_quality"
  ],
  "janitor": {
    "window_local": "04:00-06:00",
    "max_pages_per_night": 15,
    "max_wall_seconds": 5400,
    "model_provider": "custom:pinto",
    "model": "nvidia/Qwen3.6-35B-A3B-NVFP4",
    "auto_apply_programmable": true,
    "auto_apply_agent": false,
    "auto_commit": true,
    "auto_push": false,
    "auto_quartz": false,
    "skip_path_regexes": [
      "audiobook",
      "chapter\\d",
      "consent-and-recording",
      "-en-review\\.md$",
      "recording-kit"
    ],
    "skip_types": [
      "media",
      "audiobook",
      "template",
      "stub-kit"
    ]
  },
  "improvement": {
    "weekly_drain": true,
    "daily_cron": "0 5 * * *",
    "weekly_cron": "0 5 * * 1"
  },
  "autonomy": {
    "level": "L3",
    "l2_auto_publish_on_drift": true,
    "l2_auto_drain_on_ci": true,
    "l2_auto_commit_on_heal": true,
    "l2_auto_featured_on_publish": true,
    "l3_auto_push_on_green": true,
    "require_ops_not_fail": true,
    "require_smoke_pass": true,
    "require_drift_ok": true,
    "require_clean_git_for_push": false,
    "max_broken_links_for_green": 0,
    "smoke_urls": [
      "https://echocanhelp.github.io/wiki-public/",
      "https://echocanhelp.github.io/wiki-public/people/albert-s-lai",
      "https://echocanhelp.github.io/wiki-public/organizations/formosan-presbyterian-church-in-los-angeles",
      "https://echocanhelp.github.io/wiki-public/organizations/irvine-taiwanese-presbyterian-church",
      "https://echocanhelp.github.io/wiki-public/sources/toward-a-community-of-hope"
    ],
    "l2_auto_site_design_heal": true,
    "l2_auto_site_design_featured": true,
    "l2_auto_site_design_publish": true,
    "l2_site_design_blocks_green": false,
    "smoke_trailing_slash": "soft_404_js_redirect"
  }
}
